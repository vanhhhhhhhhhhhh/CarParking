<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CarParking" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="actionBarTheme">@style/CustomActionBarStyle</item>
    </style>

    <style name="CustomActionBarStyle" parent="@style/Widget.MaterialComponents.ActionBar.Solid">
        <item name="android:background">@color/primary_blue</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:elevation">3dp</item>
        <item name="homeAsUpIndicator">@drawable/ic_back</item>
    </style>

    <style name="Base.Theme.CarParking.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
    </style>

    <style name="Theme.CarParking" parent="Base.Theme.CarParking" />
    <style name="Theme.CarParking.NoActionBar" parent="Base.Theme.CarParking.NoActionBar" />
</resources>