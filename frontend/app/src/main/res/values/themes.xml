<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.CarParking.NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="actionBarStyle">@style/CustomActionBarStyle</item>
        <item name="android:statusBarColor">@color/primary_blue</item>
    </style>

    <style name="Base.Theme.CarParking" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="actionBarStyle">@style/CustomActionBarStyle</item>
        <item name="android:statusBarColor">@color/primary_blue</item>
    </style>

    <style name="CustomActionBarStyle" parent="@style/Widget.AppCompat.ActionBar.Solid">
        <item name="background">@color/primary_blue</item>
        <item name="titleTextStyle">@style/CustomActionBarTitleText</item>
        <item name="homeAsUpIndicator">@drawable/ic_back</item>
    </style>

    <style name="CustomActionBarTitleText">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Theme.CarParking.NoActionBar" parent="Base.Theme.CarParking.NoActionBar" />
    <style name="Theme.CarParking" parent="Base.Theme.CarParking" />
</resources>
